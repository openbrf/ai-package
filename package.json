{
  "name": "@openbrf/ai-package",
  "version": "0.1.0",
  "description": "AI package for Open BRF: assistants for the board on the association's own model provider key, within a monthly limit.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openbrf/ai-package.git"
  },
  "files": [
    "dist",
    "locales"
  ],
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "vite build && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:package": "node scripts/check-package.mjs"
  },
  "openbrf": {
    "apiVersion": 1,
    "id": "ai-package",
    "entry": {
      "server": "./dist/server.cjs",
      "client": "./dist/remoteEntry.js"
    },
    "permissions": [],
    "personalData": [
      "name",
      "apartment",
      "freeText",
      "health"
    ],
    "view": {
      "module": "./View",
      "titleKey": "view.title",
      "section": "board"
    },
    "settingsSchema": {
      "fields": [
        {
          "key": "apiKey",
          "type": "secret",
          "labelKey": "settings.apiKey.label",
          "hintKey": "settings.apiKey.hint",
          "maxLength": 512
        },
        {
          "key": "model",
          "type": "select",
          "labelKey": "settings.model.label",
          "hintKey": "settings.model.hint",
          "default": "claude-opus-5-5",
          "options": [
            {
              "value": "claude-opus-5-5",
              "labelKey": "settings.model.options.opus"
            },
            {
              "value": "claude-sonnet-5-5",
              "labelKey": "settings.model.options.sonnet"
            },
            {
              "value": "claude-haiku-5-5",
              "labelKey": "settings.model.options.haiku"
            }
          ]
        },
        {
          "key": "monthlyTokenLimit",
          "type": "number",
          "labelKey": "settings.monthlyTokenLimit.label",
          "hintKey": "settings.monthlyTokenLimit.hint",
          "integer": true,
          "min": 0,
          "max": 1000000000,
          "default": 2000000
        },
        {
          "key": "requestsPerMinute",
          "type": "number",
          "labelKey": "settings.requestsPerMinute.label",
          "hintKey": "settings.requestsPerMinute.hint",
          "integer": true,
          "min": 1,
          "max": 120,
          "default": 10
        }
      ]
    },
    "actions": [],
    "ai": true,
    "recipients": [
      {
        "id": "model-provider",
        "origin": "https://api.anthropic.com",
        "purpose": {
          "sv": "Anthropic, föreningens leverantör av språkmodell, får texten en assistent arbetar med och svarar med ett förslag. Föreningen anlitar Anthropic med sin egen API-nyckel och på sitt eget avtal med Anthropic.",
          "en": "Anthropic, the association's language model provider, receives the text an assistant works on and answers with a draft. The association engages Anthropic with its own API key and under its own agreement with Anthropic."
        },
        "personalData": [
          "name",
          "apartment",
          "freeText",
          "health"
        ]
      }
    ],
    "licence": {
      "entitlement": "ai-package",
      "issuer": {
        "name": "Apteo AB",
        "url": "https://apteo.se"
      },
      "keys": {
        "unissued": "JWxgqu/xyNQpBjo5vbvKwsPyMhwGVY6InYHuPs2bUuE="
      },
      "audiences": []
    },
    "released": "2026-10-22"
  },
  "peerDependencies": {
    "@nestjs/common": "^12.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "1.1.0",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@module-federation/vite": "1.23.5",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-fastify": "12.1.3",
    "@openbrf/plugin-sdk": "1.0.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "fastify": "5.12.5",
    "i18next": "26.5.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "17.1.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "zod": "4.6.7"
  }
}
